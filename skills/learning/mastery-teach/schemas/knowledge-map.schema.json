{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery Teach Knowledge Map",
  "type": "object",
  "required": [
    "schema_version",
    "map_id",
    "title",
    "version",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "mission_scope": {
      "type": "string"
    },
    "completion_policy": {
      "type": "object",
      "properties": {
        "required_importance": {
          "type": "array",
          "items": {
            "enum": [
              "core",
              "supporting",
              "specialization",
              "optional"
            ]
          }
        },
        "minimum_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "require_mastery_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "domain",
          "importance",
          "depth",
          "outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "importance": {
            "enum": [
              "core",
              "supporting",
              "specialization",
              "optional"
            ]
          },
          "depth": {
            "enum": [
              "foundational",
              "intermediate",
              "advanced",
              "specialist"
            ]
          },
          "description": {
            "type": "string"
          },
          "prerequisites": {
            "type": "object",
            "properties": {
              "all_of": {
                "$ref": "#/$defs/prereqList"
              },
              "any_of": {
                "$ref": "#/$defs/prereqList"
              }
            },
            "additionalProperties": false
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "statement"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "statement": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "evidence_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "level_criteria": {
            "type": "object",
            "properties": {
              "familiar": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "functional": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "proficient": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "resource_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_assessment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unlocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "research_notes": {
      "type": "object"
    }
  },
  "$defs": {
    "prereqList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "min_level"
        ],
        "properties": {
          "node": {
            "type": "string"
          },
          "min_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
