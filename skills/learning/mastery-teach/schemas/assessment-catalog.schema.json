{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery Teach Assessment Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "assessments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "provenance",
          "node_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "external",
              "generated",
              "practical"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_or_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome_ids": {
            "type": "object"
          },
          "answer_key_available": {
            "type": "boolean"
          },
          "access": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
